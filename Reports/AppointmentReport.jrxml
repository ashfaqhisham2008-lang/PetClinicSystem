<jasperReport name="AppointmentReport" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0fa9916d-6aa3-49fc-a2ed-fffd2a841c3b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PetClinicDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT
c.customer_name,
p.pet_name,
p.pet_type,
a.appointment_date,
a.appointment_time,
a.service_type
FROM customer c
INNER JOIN pet p
ON c.customer_ID = p.customer_ID
INNER JOIN appointment a
ON p.pet_ID = a.pet_ID]]></query>
